# Copia in .env per i comandi locali (webhook, chatid).
# In produzione questi valori vanno nelle Environment Variables del
# progetto su Vercel. NON committare mai il file .env con i valori veri.

# --- Telegram ---
# Il token te lo dà @BotFather quando crei il bot con /newbot.
TELEGRAM_BOT_TOKEN=

# Il segreto che Telegram rimanda a ogni richiesta, così nessun altro
# può fingersi Telegram e scrivere sulla collezione.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_SECRET_TOKEN=

# Il tuo identificativo su Telegram: il bot ignora chiunque altro.
# Lo trovi con: npm run chatid (dopo aver scritto un messaggio al bot)
TELEGRAM_CHAT_ID=

# --- Database (Supabase) ---
# La stessa stringa del backend. Usa quella del POOLER (porta 6543,
# host ...pooler.supabase.com): su serverless ogni invocazione apre la
# sua connessione, e le connessioni dirette finiscono in fretta.
DATABASE_URL=

# --- Solo per i comandi locali ---
# L'indirizzo del progetto su Vercel, senza barra finale.
BOT_URL=https://mangavault10x-bot.vercel.app

# --- Bot delle uscite (@Videoteca10xBot) ---
# Il secondo bot: avvisa quando esce una puntata degli anime in
# videoteca. La parte che MANDA sta nel backend (services/avvisi.js);
# qui c'è solo quella che ASCOLTA — /start e la scelta del nome — e sta
# qui perché Render dorme e Vercel no.
TELEGRAM_USCITE_TOKEN=

# Come TELEGRAM_SECRET_TOKEN ma per il secondo webhook. Suo, non lo
# stesso: due bot che condividono un segreto sono un segreto solo.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_USCITE_SECRET=

# Il codice con cui il PROPRIETARIO si collega al bot delle uscite (o cambia telefono):
# `/start IL-CODICE`. Almeno 16 caratteri, tuo e di nessun altro. Se manca, o è più corto,
# quella strada non esiste. Dopo averlo usato cancella il messaggio dalla chat.
# Genera con: node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"
# Il proprietario NON si sceglie dai bottoni e NON si scollega dal bot: vedi api/uscite.js.
TELEGRAM_USCITE_CODICE_PROPRIETARIO=

# L'indirizzo del sito, per i link dentro i messaggi.
SITO_URL=https://mangavault10x-frontend.vercel.app
